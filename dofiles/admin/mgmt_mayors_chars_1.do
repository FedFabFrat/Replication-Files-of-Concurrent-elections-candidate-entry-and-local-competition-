/* DATA MGMT OF LOCAL ELECTIONS */

** defines directory **
cd "$maindir/data/admin/raw"
clear


**# ** unzip admin raw data **
local myfilelist : dir . files"*.zip"
foreach file of local myfilelist {
	unzipfile "`file'", replace
}


**# ** import in Stata and retrieve mayor info **
forvalues x=1990/2019 {
	local myfilelist : dir . files"*`x'*.csv"
	foreach file of local myfilelist {
		import delimited "`file'", delimiter(";") varnames(1) asdouble encoding(ISO-8859-1) stringcols(_all) clear 
		rename descrizione_regione regione
		rename descrizione_provincia provincia
		rename descrizione_comune comune
		rename popolazione_censita pop2
// 		gen mayor = 1 if descrizione_carica=="Sindaco"
// 		keep if mayor == 1 
// 		drop mayor
		gen nome_cognome=strtrim(cognome+" "+nome)
		gen anno=`x'
		drop data_ballottaggio sigla_provincia consiglieri_spettanti assessori_assegnati sigla_titolo_accademico cognome nome partito_lista_coalizione data_cessazione maggioritario_proporzionale descrizione_tempo_gestione data_nomina
		save mayors_`x'.dta, replace
	}
}


**# ** append data and save it **
use mayors_1990.dta, clear
forvalues x=1991/2019 {
	local myfilelist : dir . files"mayors_`x'*.dta"
	foreach file of local myfilelist {
		append using `file'
	}
}


**# ** data mgmt **

* format strings *
ds, has(type string) 
local strvars "`r(varlist)'"
format `strvars' %15s

* sort *
sort comune anno
order comune anno

* drop regioni *
ta regione
drop if substr(regione,1,8) == "TRENTINO" // recover somewhere else
drop if substr(regione,1,6) == "FRIULI" // recover somewhere else
drop if regione == "VALLE D'AOSTA" // recover somewhere else
drop if regione == "SICILIA" // recover somewhere else
drop if regione == "SARDEGNA" // recover somewhere else
// drop regione
drop codice_regione

* drop provincia *
// drop provincia
drop codice_provincia

* date mgmt *
split data_elezione, p("/")
rename data_elezione1 day
replace day = subinstr(day,"0","",.) if substr(day,1,1) == "0"
rename data_elezione2 month
replace month = subinstr(month,"0","",.) if substr(month,1,1) == "0"
rename data_elezione3 year
foreach var of varlist day month year {
	destring `var', replace
}
gen ele_date=mdy(month,day,year)
format ele_date %td
drop day month year data_elezione

* keep mayors elected post 1991 *
// keep if year(ele_date) >= 1991 

* destring population *
destring pop2, replace
rename pop2 pop

* gen education *
ta titolo_di_studio
gen educ = 0 if inlist(titolo_di_studio, "NESSUN TITOLO DI STUDIO POSSEDUTO", "LICENZA ELEMENTARE") 
replace educ = 1 if inlist(titolo_di_studio, "LICENZA MEDIA INFERIORE","TITOLI O DIPLOMI PROFESSIONALI POST LIC.ELEMENTARE","LICENZA DI SCUOLA MEDIA INF. O TITOLI EQUIPOLLENTI")
replace educ = 2 if inlist(titolo_di_studio, "LICENZA MEDIA SUPERIORE","TITOLI O DIPLOMI PROFESSIONALI POST MEDIA INFER.","LICENZA DI SCUOLA MEDIA SUP. O TITOLI EQUIPOLLENTI")
replace educ = 3 if inlist(titolo_di_studio, "TITOLI O DIPLOMI PROFESSIONALI POST MEDIA SUPER.","LAUREA  BREVE","LAUREA")
replace educ = 4 if inlist(titolo_di_studio, "ALTRI TITOLI  POST-LAUREA","SPECIALIZZAZIONE POST LAUREA / DOTTORATO DI RICERCA")

* in city born mayor *
replace sede_nascita = strtrim(substr(sede_nascita,1,length(sede_nascita)-4))
gen may_born_city = 1 if comune == sede_nascita
recode may_born_city .=0

* female dum *
gen female = 1 if sesso == "M"
recode female .=0

* gen codcom *
drop codice_comune
cap drop codcom
gen codcom = istat_codice_comune
replace codcom = substr(codcom,2,length(codcom)) if substr(codcom,1,1) == "0"
destring codcom, replace

* generate variable for previous role in public admin *
sort nome_cognome data_nascita sesso anno
bys nome_cognome data_nascita sesso (anno): gen asd=_n==1
replace asd = anno if asd == 1
recode asd 0=.
bys nome_cognome data_nascita sesso (anno): carryforward asd, replace
rename asd year_first_experience

* keep only mayors and compute experience in office *
keep if descrizione_carica == "Sindaco"
gen exp_in_office = 1 if year_first_experience != anno
replace exp_in_office = . if year_first_experience == year(ele_date)
recode exp_in_office .=0
drop descrizione_carica livello_carica

* drop duplicates *
duplicates drop codcom anno, force

* mgmt id vars *
foreach x of varlist comune regione provincia {
	rename `x' `x'_mayors
}

* age *
gen year_born = substr(data_nascita,length(data_nascita)-3,4)
destring year_born, replace
gen age = anno-year_born
gen age2 = age^2

