				"ADDETTI AD ATTIVITà AUSILIARIE DI UFFICIO (USCIERI, COMMESSI, LETTORI DI CONTATORI, ECC.) O DI MAGAZZINO, SPOSTAMENTO MERCI E COMUNICAZIONI (FACCHINI, ADDETTI ALLO SPOSTAMENTO, IMBALLAGGIO E CONSEGNA MERCI E AL MAGAZZINO, PORTALETTERE E FATTORINI, CENTRAL" ///
				"ADDETTI AD ATTIVITà NON QUALIFICATE DELL'AGRICOLTURA, DELL'ALLEVAMENTO, DELLA PESCA E DELLA FORESTAZIONE (BRACCIANTI AGRICOLI, ADDETTI ALLE CURE DEGLI ANIMALI, ECC.)" ///
				"CASALINGHE" "MANOVALI EDILI,STERRATORI E ASSIMILATI" ///
				"ADDETTI ALL'ASSISTENZA ALLE PERSONE E ALLE FAMIGLIE" "STUDENTI" "COMMESSI, USCIERI, BIDELLI, INSERVIENTI DI UFFICI PUBBLICI E PRIVATI" ///
				{
replace job_type=8 if professione=="`job'"
}
foreach job in 	"UFFICIALI DELLE FORZE ARMATE" "UFFICIALI DEI CARABINIERI, DI POLIZIA, DELLA GUARDIADI FINANZA, DEI VIGILI DEL FUOCO E ASSIMILATI" ///
				"CARABINIERI, AGENTI DI POLIZIA, GUARDIE DI FINANZA, VIGILI DEL FUOCO E ASSIMILATI"  ///
				"APPARTENENTI A FORZE ARMATE E A FORZE DI POLIZIA, TECNICI E ADDETTI A SERVIZI DI SICUREZZA PUBBLICA E VIGILANZA PUBBLICA E PRIVATA" ///
				"SOTTUFFICIALI" "SOTTUFFICIALI DEI CARABINIERI, DI POLIZIA, DELLA GUARDIA DI FINANZA, DEI VIGILI DEL FUOCO E ASSIMILATI" ///
				"SOTTUFFICIALI E MILITARI DELLE FORZE ARMATE" "UFFICIALI" {
replace job_type=9 if professione=="`job'"
}
ta professione if job_type==.
recode job_type .=99 if professione!=""
forvalues x=1/9 {
	gen job_cpi_`x'=1 if job_type==`x'
	recode job_cpi_`x' .=0
}

* keep relevant vars *
keep comune_mayors ele_date anno regione_mayors provincia_mayors istat_codice_comune pop educ may_born_city female codcom year_born age age2 nome_cognome job_type job_cpi* exp_in_office

* last mgmt *
rename nome_cognome name_winner
keep if anno == year(ele_date)
drop if anno == 1990


** save dataset **
save "$maindir/data/admin/mayors_chars_0525.dta", replace



